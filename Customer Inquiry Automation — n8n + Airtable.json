        "subject": "High-priority customer inquiry: {{ $('Validate & Classify').item.json.fullName }}",
        "html": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>High-Priority Customer Inquiry</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f6f8; font-family:Arial,Helvetica,sans-serif; color:#333333;\">\n  <div style=\"max-width:650px; margin:40px auto; background:#ffffff; border-radius:8px; padding:32px;\">\n\n    <h2 style=\"margin-top:0; color:#b42318;\">\n      High-Priority Customer Inquiry\n    </h2>\n\n    <p style=\"font-size:16px; line-height:1.6;\">\n      A new high-priority customer inquiry has been received.\n    </p>\n\n    <table style=\"width:100%; border-collapse:collapse; margin:20px 0;\">\n\n      <tr>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee; font-weight:bold;\">\n          Customer\n        </td>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee;\">\n          {{ $('Validate & Classify').item.json.fullName }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee; font-weight:bold;\">\n          Email\n        </td>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee;\">\n          {{ $('Validate & Classify').item.json.email }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee; font-weight:bold;\">\n          Phone\n        </td>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee;\">\n          {{ $('Validate & Classify').item.json.phone || 'Not provided' }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee; font-weight:bold;\">\n          Company\n        </td>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee;\">\n          {{ $('Validate & Classify').item.json.company || 'Not provided' }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee; font-weight:bold;\">\n          Priority\n        </td>\n        <td style=\"padding:10px; border-bottom:1px solid #eeeeee; color:#b42318; font-weight:bold;\">\n          HIGH\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding:10px; font-weight:bold; vertical-align:top;\">\n          Message\n        </td>\n        <td style=\"padding:10px;\">\n          {{ $('Validate & Classify').item.json.message }}\n        </td>\n      </tr>\n\n    </table>\n\n    <div style=\"margin-top:24px; padding:16px; background:#fff4f2; border-left:4px solid #b42318;\">\n      <strong>Action required:</strong>\n      Please review and handle this inquiry as soon as possible.\n    </div>\n\n    <p style=\"font-size:14px; color:#777777; margin-top:30px;\">\n      This notification was generated automatically by the Customer Inquiry Automation workflow.\n    </p>\n\n  </div>\n</body>\n</html>",
