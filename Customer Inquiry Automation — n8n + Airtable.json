    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\n\nconst fullName = String(data.fullName ?? '').trim();\nconst email = String(data.email ?? '').trim().toLowerCase();\nconst message = String(data.message ?? '').trim();\n\nconst missing = [];\nif (!fullName) missing.push('fullName');\nif (!email) missing.push('email');\nif (!message) missing.push('message');\n\nif (missing.length) {\n  return [{\n    json: {\n      valid: false,\n      error: `Missing required field(s): ${missing.join(', ')}`,\n      receivedAt: new Date().toISOString()\n    }\n  }];\n}\n\nconst phone = String(data.phone ?? '').trim();\nconst company = String(data.company ?? '').trim();\nconst source = String(data.source ?? 'Website').trim();\n\nconst urgentWords = [\n  'urgent', 'asap', 'emergency', 'critical', 'immediately',\n  'deadline', 'today', 'right away'\n];\n\nconst haystack = `${message} ${String(data.subject ?? '')}`.toLowerCase();\nconst priority = urgentWords.some(word => haystack.includes(word))\n  ? 'High'\n  : 'Normal';\n\nfunction addBusinessDays(date, days) {\n  const d = new Date(date);\n  let added = 0;\n  while (added < days) {\n    d.setDate(d.getDate() + 1);\n    const day = d.getDay();\n    if (day !== 0 && day !== 6) added++;\n  }\n  return d;\n}\n\nconst receivedAt = new Date();\nconst followUpAt = addBusinessDays(receivedAt, 2);\n\nreturn [{\n  json: {\n    valid: true,\n    fullName,\n    email,\n    phone,\n    company,\n    message,\n    source,\n    priority,\n    status: 'New',\n    handled: false,\n    receivedAt: receivedAt.toISOString(),\n    followUpAt: followUpAt.toISOString()\n  }\n}];"
      },
